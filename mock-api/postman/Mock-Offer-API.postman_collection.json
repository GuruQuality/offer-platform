    "_postman_id": "a1b2c3d4-1111-4222-8333-444455556666",
    "name": "Mock Offer API",
    "description": "Коллекция для локального mock-сервера FastAPI.\n\nПеред запуском коллекции запустите сервер:\n\ncd mock-api\n./.venv/bin/python -m uvicorn app:app --reload --port 8000\n\nЗатем выберите окружение «Mock Offer API — Local» и нажмите Run collection.\nВсе запросы используют переменную {{baseUrl}}, поэтому коллекция работает на компьютере любого разработчика.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Успешные запросы",
      "item": [
        {
          "name": "alpha — успешный запрос",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "const requestBody = JSON.parse(pm.request.body.raw);",
                  "",
                  "pm.test('Ответ содержит обязательные поля', function () {",
                  "    pm.expect(response).to.have.property('traceId');",
                  "    pm.expect(response).to.have.property('userId');",
                  "    pm.expect(response).to.have.property('timestamp');",
                  "    pm.expect(response).to.have.property('offers');",
                  "});",
                  "",
                  "pm.test('traceId сгенерирован', function () {",
                  "    pm.expect(response.traceId).to.match(/^trace-[a-f0-9]{8}$/);",
                  "});",
                  "",
                  "pm.test('timestamp в формате UTC ISO 8601', function () {",
                  "    pm.expect(response.timestamp).to.match(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/);",
                  "});",
                  "",
                  "pm.test('userId взят из запроса', function () {",
                  "    pm.expect(response.userId).to.eql(requestBody.userId);",
                  "});",
                  "",
                  "pm.test('Оффер соответствует контракту', function () {",
                  "    pm.expect(response.offers).to.be.an('array').with.lengthOf(1);",
                  "    pm.expect(response.offers[0].details.offerId).to.eql('offer-1');",
                  "    pm.expect(response.offers[0].details.noticeId).to.eql('notice-1');",
                  "    pm.expect(response.offers[0].notice).to.eql('Оффер успешен');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-123\",\n  \"ruleName\": \"rule-1\",\n  \"eventTs\": \"2025-01-01T10:00:00Z\",\n  \"triggerTs\": \"2025-01-01T10:05:00Z\",\n  \"metadata\": {\n    \"userId\": \"user-123\",\n    \"source\": \"web\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/alpha/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alpha",
                "request"
              ]
            },
            "description": "Успешный запрос в тестовую среду alpha."
          },
          "response": []
        },
